@page "/email/check"

<PageTitle>Check Your Email - Project KONGOR</PageTitle>

<MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="px-4 px-sm-6">
    <MudCard Class="glass-card-form animate-fade-in pa-6" Elevation="0" Style="width: 100%; max-width: 640px;">
        <MudCardContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h5" HtmlTag="h1">Check your email</MudText>
                </MudStack>
                <MudText Align="Align.Center">
                    @if (IsPasswordReset)
                    {
                        <text>If an account uses the email address you entered, you’ll receive a link to reset your password.</text>
                    }
                    else
                    {
                        <text>Open the verification link in your email to finish creating your account.</text>
                    }
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Check your spam or junk folder if the email hasn’t arrived.
                </MudText>
                <MudStack Row="true" Justify="Justify.Center" Class="flex-wrap mt-2">
                    <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Class="glow-button">Back to log in</MudButton>
                    <MudButton Href="@(IsPasswordReset ? "/password/recover" : "/email/register")" Variant="Variant.Outlined" Color="Color.Primary">Try a different email</MudButton>
                </MudStack>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudStack>

@code {
    [SupplyParameterFromQuery]
    private string? Purpose { get; set; }

    private bool IsPasswordReset => Purpose == "password-reset";
}
