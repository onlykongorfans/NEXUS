@page "/password/recover/{Token}"

@inject PortalAuthenticationService AuthenticationService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Confirm Password Reset - Project KONGOR</PageTitle>

<MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="px-4 px-sm-6" >
    <MudCard Class="glass-card-form animate-fade-in pa-6" Elevation="0" Style="width: 100%; max-width: 640px;">
        <MudCardContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h5">Confirm Password Reset</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                    Choose a new password for every account linked to this email address.
                </MudText>
            </MudStack>

            <EditForm Model="FormModel" OnValidSubmit="HandleConfirm">
                <DataAnnotationsValidator />

                <MudStack Spacing="3">
                    <MudTextField @bind-Value="FormModel.Password"
                                  For="@(() => FormModel.Password)"
                                  Label="New Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock" />

                    <MudTextField @bind-Value="FormModel.ConfirmPassword"
                                  For="@(() => FormModel.ConfirmPassword)"
                                  Label="Confirm New Password"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Password"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock" />

                    <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="glow-button"
                                   Disabled="Processing">
                            @if (Processing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <MudText>Resetting...</MudText>
                            }
                            else
                            {
                                <MudText>Reset Password</MudText>
                            }
                        </MudButton>
                    </MudStack>
                </MudStack>
            </EditForm>
        </MudCardContent>
    </MudCard>

    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
        <MudLink Href="/login">Return to log in</MudLink>
    </MudText>
</MudStack>

@code {

    [Parameter]
    public string? Token { get; set; }

    private ResetPasswordFormModel FormModel { get; set; } = new ();

    private bool Processing { get; set; }

    private async Task HandleConfirm()
    {
        Processing = true;

        try
        {
            HttpClient client = AuthenticationService.CreateAnonymousClient();

            ConfirmAccountPasswordResetRequest request = new (Token ?? string.Empty, FormModel.Password, FormModel.ConfirmPassword);

            HttpResponseMessage response = await client.PostAsJsonAsync("/Password/Reset/Confirm", request);

            if (response.StatusCode is HttpStatusCode.OK)
            {
                Snackbar.Add("Password reset successfully.", Severity.Success);
                Snackbar.Add("You can now log in with your chosen password.", Severity.Info);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                string errorMessage = await response.Content.ReadAsStringAsync();
                Snackbar.Add(errorMessage, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server. Please try again later.", Severity.Error);
        }
        finally
        {
            Processing = false;
        }
    }
}
