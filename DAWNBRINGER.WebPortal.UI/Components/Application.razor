<!DOCTYPE html>

<html lang="en">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
        <meta name="color-scheme" content="dark light" />
        <meta name="description" content="Project KONGOR user portal for account management, downloads, documentation, news, and links to community hubs." />
        <meta name="theme-color" content="#0d1610" />

        <base href="/" />

        <link rel="icon" type="image/png" href="images/logo.png" />

        <PageTitle>Project KONGOR</PageTitle>

        <HeadOutlet @rendermode="RenderMode.InteractiveServer" />

        <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
        <link href="@Assets["css/fonts.css"]" rel="stylesheet" />
        <link href="@Assets["css/portal.common.css"]" rel="stylesheet" />
        <link href="@Assets["css/portal.dark.css"]" rel="stylesheet" />
        <link href="@Assets["css/cursor.css"]" rel="stylesheet" />
    </head>

    <body>
        <Routes @rendermode="RouteRenderMode" />

        <canvas id="fluid" aria-hidden="true"></canvas>

        <script src="_framework/blazor.web.js"></script>
        <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
        <script src="@Assets["js/cursor.js"]" defer></script>
    </body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private InteractiveServerRenderMode RouteRenderMode
    {
        get
        {
            Type? pageType = HttpContext?.GetEndpoint()?.Metadata.GetMetadata<ComponentTypeMetadata>()?.Type;

            // Account Pages Depend On Browser Storage And Interactive Forms
            bool prerender = pageType == typeof(Pages.Home) || pageType == typeof(Pages.Downloads) ||
                pageType == typeof(Pages.HowToPlay) || pageType == typeof(Pages.NotFound) || pageType == typeof(Pages.CheckYourEmail);

            return new InteractiveServerRenderMode(prerender);
        }
    }
}
